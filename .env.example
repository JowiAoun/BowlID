# Amplitude project API key. Leave empty to turn analytics off.
VITE_AMPLITUDE_API_KEY=

# Port of the local Wii remote bridge.
BOWLBANK_BRIDGE_PORT=8765

# Accelerometer calibration for your Wii remote. Run `node bridge/calibrate.mjs` to measure it.
# BOWLBANK_ACCEL_ZERO=0,0,0
# BOWLBANK_ACCEL_COUNTS_PER_G=104
